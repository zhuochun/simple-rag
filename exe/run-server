#!/usr/bin/env ruby
# encoding: utf-8

require "digest"
require "optparse"
require "pathname"

begin
  require "bundler/setup"
rescue LoadError
end

require_relative "../llm/llm"
require_relative "../server/app"
require_relative "../server/article"
require_relative "../server/cache"
require_relative "../server/discuss"
require_relative "../server/dismissal_store"
require_relative "../server/duplicate"
require_relative "../server/retriever"
require_relative "../lib/config_loader"
require_relative "../lib/config_path_resolver"
require_relative "../lib/ollama_service"
require_relative "../lib/provider_env_validator"

options = { bind: nil, port: nil }
parser = OptionParser.new do |opts|
  opts.banner = "Usage: run-server [config.json] [--bind HOSTNAME] [--port PORT]"
  opts.on("--bind HOSTNAME", "Bind the server to a specific hostname or IP address") { |host| options[:bind] = host }
  opts.on("--port PORT", Integer, "Bind the server to a specific port") { |port| options[:port] = port }
end

begin
  parser.parse!(ARGV)
  raise OptionParser::InvalidArgument, "expected at most one config file path" if ARGV.length > 1
rescue OptionParser::ParseError => error
  STDOUT << "#{error.message}\n#{parser}\n"
  exit 1
end

config_file = ConfigPathResolver.resolve_config_path(ARGV[0])
unless config_file
  STDOUT << "#{ConfigPathResolver.default_search_message}\n"
  exit 1
end

begin
  config = ConfigLoader.load_config(config_file, with_path_map: true)
rescue => error
  STDOUT << "Config error: #{error.message}\n"
  exit 1
end

# The provider functions still read CONFIG; all server modules receive explicit dependencies.
CONFIG = config

exit 9 unless OllamaService.ensure_started(config, sections: [:embedding])
missing_key = ProviderEnvValidator.missing_key_message(config, sections: [:embedding])
if missing_key
  STDOUT << "#{missing_key}\n"
  exit 9
end

locator = SimpleRag::DocumentLocator.new
catalog = SimpleRag::IndexCatalog.new(locator: locator)
cached_embedding = ->(query) { CACHE.get_or_set(query, method(:embedding).to_proc) }
begin
  trace_writer = SimpleRag::QueryTraceWriter.build(
    config: config,
    config_file: config_file,
    source: "server"
  )
rescue => error
  STDOUT << "Query log error: #{error.message}\n"
  exit 1
end
retriever = SimpleRag::RetrieverFactory.build(
  chat_fn: method(:chat),
  embedding_fn: cached_embedding,
  locator: locator,
  trace_writer: trace_writer
)
similarity_retriever = SimpleRag::SimilarityRetriever.new(
  embedding_fn: cached_embedding,
  catalog: catalog
)
duplicate_finder = SimpleRag::DuplicateFinder.new(catalog: catalog, locator: locator)

base_dir = File.dirname(config_file)
dismissed_path = config.respond_to?(:dismissedDuplicatesFile) ? config.dismissedDuplicatesFile.to_s.strip : ""
unless dismissed_path.empty? || Pathname.new(dismissed_path).absolute?
  dismissed_path = File.expand_path(dismissed_path, base_dir)
end
dismissals = SimpleRag::DismissalStore.new(dismissed_path)

jina = config.respond_to?(:jina) ? config.jina : nil
jina_token = jina.respond_to?(:token) ? jina.token : jina.is_a?(Hash) ? jina["token"] : nil
cache_dir = jina.respond_to?(:cacheDir) ? jina.cacheDir : jina.is_a?(Hash) ? jina["cacheDir"] : nil
if cache_dir && !cache_dir.to_s.strip.empty? && !Pathname.new(cache_dir.to_s).absolute?
  cache_dir = File.expand_path(cache_dir.to_s, base_dir)
end
article_reader = SimpleRag::ArticleReader.new(
  token: jina_token,
  cache_dir: cache_dir,
  chat_fn: method(:chat)
)

runtime = SimpleRag::ServerRuntime.new(
  config_file: config_file,
  config_digest: Digest::SHA256.file(config_file).hexdigest,
  config: config,
  retriever: retriever,
  similarity_retriever: similarity_retriever,
  duplicate_finder: duplicate_finder,
  catalog: catalog,
  locator: locator,
  dismissals: dismissals,
  article_reader: article_reader,
  discuss_fn: method(:discuss_note)
)

begin
  catalog.warm!(config.paths)
rescue => error
  STDOUT << "SQLite vector index error: #{error.message}\n"
  exit 9
end

app = SimpleRag::ServerApp.for_runtime(runtime: runtime)
app.set :server, :webrick if Gem::Platform.local.to_s.include?("mingw-ucrt")
at_exit { runtime.close }

run_options = {}
run_options[:bind] = options[:bind] if options[:bind]
run_options[:port] = options[:port] if options[:port]
app.run!(run_options)
