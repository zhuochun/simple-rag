#!/usr/bin/env ruby
# encoding: utf-8

require "stringio"
require "thread"

begin
  require "bundler/setup"
rescue LoadError
end

require_relative "../llm/llm"
require_relative "../readers/reader"
require_relative "../lib/config_loader"
require_relative "../lib/config_path_resolver"
require_relative "../lib/indexing"
require_relative "../lib/ollama_service"
require_relative "../lib/provider_env_validator"

BUILD_MODES = %w[delta full].freeze
DEFAULT_BUILD_MODE = "delta".freeze

def usage_text
  <<~USAGE
    Usage: run-index [--build-mode delta|full] [--workers N] [--allow-empty-prune] [--non-interactive] [config.json]

    Options:
      --build-mode MODE   Build mode: delta (default) or full. Delta falls back to full when the index or scan timestamp is missing.
      --workers N         Maximum paths indexed concurrently (default: #{SimpleRag::Indexing::Runner::DEFAULT_WORKERS}).
      --allow-empty-prune  Allow deleting stale rows when a path scan returns zero files.
      --non-interactive    Print only the final indexing summary.
      -h, --help           Show this help.
  USAGE
end

def summary_line(matched:, read:, created:, skipped:, errors:)
  "Match #{matched}, Read #{read} files | Create #{created}, Skip #{skipped}, Err #{errors} chunks"
end

def path_summary_line(path_name, summary)
  "#{path_name}: #{summary_line(
    matched: summary[:matched_files].to_i,
    read: summary[:read_files].to_i,
    created: summary[:created].to_i,
    skipped: summary[:skipped].to_i,
    errors: summary[:errors].to_i
  )}"
end

def parse_cli_args(argv)
  options = {
    allow_empty_prune: false,
    non_interactive: false,
    build_mode: DEFAULT_BUILD_MODE,
    workers: SimpleRag::Indexing::Runner::DEFAULT_WORKERS,
    config_arg: nil
  }

  index = 0
  while index < argv.length
    argument = argv[index]
    case argument
    when "--build-mode"
      index += 1
      raise ArgumentError, "Missing value for --build-mode" if index >= argv.length
      options[:build_mode] = normalize_build_mode(argv[index])
    when /\A--build-mode=(.*)\z/
      options[:build_mode] = normalize_build_mode(Regexp.last_match(1))
    when "--workers"
      index += 1
      raise ArgumentError, "Missing value for --workers" if index >= argv.length
      options[:workers] = positive_integer(argv[index], "--workers")
    when /\A--workers=(.*)\z/
      options[:workers] = positive_integer(Regexp.last_match(1), "--workers")
    when "--allow-empty-prune"
      options[:allow_empty_prune] = true
    when "--non-interactive"
      options[:non_interactive] = true
    when "-h", "--help"
      STDOUT << usage_text
      exit 0
    when /\A-/
      raise ArgumentError, "Unknown option: #{argument}"
    else
      raise ArgumentError, "Expected at most one config file path" if options[:config_arg]
      options[:config_arg] = argument
    end
    index += 1
  end
  options
end

def normalize_build_mode(value)
  mode = value.to_s.strip.downcase
  raise ArgumentError, "Invalid build mode: #{value.inspect}. Expected one of: #{BUILD_MODES.join(', ')}" unless BUILD_MODES.include?(mode)
  mode
end

def positive_integer(value, name)
  number = Integer(value)
  raise ArgumentError, "#{name} must be > 0" unless number.positive?
  number
rescue ArgumentError, TypeError
  raise ArgumentError, "#{name} must be > 0"
end

class StatusPrinter
  def initialize(enabled:)
    @enabled = enabled
    @mutex = Mutex.new
    @messages = {}
    @stop = false
  end

  def start
    return unless @enabled

    @thread = Thread.new do
      previous = []
      loop do
        lines = @mutex.synchronize { @messages.values }
        rendered = lines.empty? ? ["Indexing..."] : lines
        previous = render(rendered, previous) if rendered != previous
        break if @stop
        sleep 0.25
      end
      Thread.current[:lines] = previous
    end
  end

  def update(path, message)
    @mutex.synchronize { @messages[path] = message } if @enabled
  end

  def stop
    return unless @thread

    @stop = true
    @thread.join
    clear(@thread[:lines] || [])
  end

  private

  def render(lines, previous)
    STDOUT << "\r" if previous.any?
    STDOUT << "\e[#{previous.length - 1}F" if previous.length > 1
    padded = lines.each_with_index.map { |line, index| line.ljust([line.length, previous[index].to_s.length].max) }
    padded.each_with_index do |line, index|
      STDOUT << "\e[2K" << line
      STDOUT << "\n" unless index == padded.length - 1
    end
    STDOUT.flush
    padded
  end

  def clear(lines)
    return if lines.empty?

    STDOUT << "\r"
    STDOUT << "\e[#{lines.length - 1}F" if lines.length > 1
    lines.each_index do |index|
      STDOUT << "\e[2K"
      STDOUT << "\n" unless index == lines.length - 1
    end
    STDOUT << "\e[#{lines.length - 1}F" if lines.length > 1
    STDOUT << "\r"
  end
end

begin
  cli = parse_cli_args(ARGV)
rescue ArgumentError => error
  STDOUT << "#{error.message}\n\n#{usage_text}"
  exit 1
end

config_file = ConfigPathResolver.resolve_config_path(cli[:config_arg])
unless config_file
  if cli[:non_interactive]
    STDOUT << summary_line(matched: 0, read: 0, created: 0, skipped: 0, errors: 1) << "\n"
  else
    STDOUT << "#{ConfigPathResolver.default_search_message}\n"
  end
  exit 1
end

begin
  config = ConfigLoader.load_config(config_file)
rescue => error
  message = cli[:non_interactive] ? summary_line(matched: 0, read: 0, created: 0, skipped: 0, errors: 1) : "Config error: #{error.message}"
  STDOUT << "#{message}\n"
  exit 1
end

CONFIG = config
unless cli[:non_interactive]
  STDOUT << "Using config: #{config_file}\n"
  STDOUT << "build_mode=#{cli[:build_mode]}\n"
  STDOUT << "workers=#{cli[:workers]}\n"
  STDOUT << "allow_empty_prune=#{cli[:allow_empty_prune]}\n"
end

service_output = cli[:non_interactive] ? StringIO.new : STDOUT
unless OllamaService.ensure_started(config, out: service_output)
  STDOUT << summary_line(matched: 0, read: 0, created: 0, skipped: 0, errors: 1) << "\n" if cli[:non_interactive]
  exit 9
end

missing_key = ProviderEnvValidator.missing_key_message(config)
if missing_key
  message = cli[:non_interactive] ? summary_line(matched: 0, read: 0, created: 0, skipped: 0, errors: 1) : missing_key
  STDOUT << "#{message}\n"
  exit 9
end

printer = StatusPrinter.new(enabled: STDOUT.tty? && !cli[:non_interactive])
printer.start
indexer = SimpleRag::Indexing::Indexer.new(embedding_fn: method(:embedding), reader_resolver: method(:get_reader))
runner = SimpleRag::Indexing::Runner.new(indexer: indexer, workers: cli[:workers])
results = runner.run(
  config.paths,
  allow_empty_prune: cli[:allow_empty_prune],
  build_mode: cli[:build_mode],
  on_status: printer.method(:update)
)
printer.stop

unless cli[:non_interactive]
  results.select(&:failed?).each do |result|
    next if result.output.empty?
    STDOUT << "\n#{result.path} errors:\n#{result.output}"
  end
end
results.each { |result| STDOUT << "#{path_summary_line(result.path, result.summary)}\n" if result.summary }

failed_paths = results.select(&:failed?).map(&:path)
if failed_paths.any?
  STDOUT << "Failed paths: #{failed_paths.join(', ')}\n" unless cli[:non_interactive]
  exit 1
end
