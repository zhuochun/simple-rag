{
  "chat": {
    "provider": "openrouter",
    "url": "https://openrouter.ai/api/v1/chat/completions",
    "model": "gpt-3.5-turbo"
  },
  "embedding": {
    "provider": "openrouter",
    "url": "https://openrouter.ai/api/v1/embeddings",
    "model": "text-embedding-3-small"
  },
  "jina": {
    "token": "",
    "cacheDir": ""
  },
  "map": {
    "path": "map_data.json",
    "includePaths": ["temp"]
  },
  "dismissedDuplicatesFile": "dismissed.txt",
  "queryLog": {
    "enabled": false,
    "db": "D:\\Data\\simple-rag\\query-traces.sqlite"
  },
  "paths": [
    {
      "name": "temp",
      "reader": "text",
      "threshold": 0.3,
      "dir": "D:\\Studies\\tmp\\learning",
      "db": "D:\\Studies\\tmp\\learning\\learning.sqlite@learning_index",
      "nameMatch": "talks-*.md",
      "url": "",
      "searchDefault": false
    }
  ]
}
